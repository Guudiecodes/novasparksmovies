const { app, session } = require('electron');

// FIX: Prevent crash on SSL handshake reset (net_error -101)
app.commandLine.appendSwitch('disable-features', 'IsolateOrigins,site-per-process');

app.on('certificate-error', (event, webContents, url, error, certificate, callback) => {
  event.preventDefault();
  callback(true);
  console.warn('[SSL] Bypassed:', url);
});

app.on('web-contents-created', (event, contents) => {
  contents.on('did-fail-load', (event, errorCode, errorDescription, validatedURL) => {
    console.error('[CRASH-GUARD] Load failed:', validatedURL, '| Code:', errorCode);
    event.preventDefault();
  });
});

app.whenReady().then(() => {
  session.defaultSession.webRequest.onErrorOccurred((details) => {
    if (details.error && !details.error.includes('ERR_ABORTED')) {
      console.error('[NET-ERROR]', details.url, '=>', details.error);
    }
  });
});

