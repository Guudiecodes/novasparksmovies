{
  "name": "novaspark",
  "version": "8.0.4",
  "description": "NovaSpark",
  "author": {
    "name": "NovaSpark",
    "email": "admin@novaspark.app"
  },
  "license": "NS-4.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "vite build --watch",
    "start": "vite build && electron .",
    "build:web": "cross-env VERCEL=1 vite build && node obfuscate-web.js",
    "obfuscate": "node obfuscate.js",
    "dist": "cross-env ELECTRON_DIST=1 vite build && npm run obfuscate && npm run dist:linux && npm run dist:win && npm run dist:mac",
    "dist:linux": "cross-env ELECTRON_DIST=1 vite build && npm run obfuscate && electron-builder --linux deb AppImage pacman --publish never",
    "dist:deb": "cross-env ELECTRON_DIST=1 vite build && npm run obfuscate && electron-builder --linux deb --publish never",
    "dist:arch": "cross-env ELECTRON_DIST=1 vite build && npm run obfuscate && electron-builder --linux pacman --publish never",
    "dist:appimage": "cross-env ELECTRON_DIST=1 vite build && npm run obfuscate && electron-builder --linux AppImage --publish never",
    "dist:win": "cross-env ELECTRON_DIST=1 vite build && npm run obfuscate && electron-builder --win --publish never",
    "dist:mac": "cross-env ELECTRON_DIST=1 vite build && npm run obfuscate && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "gsap": "^3.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.16.0",
    "webtorrent": "^3.0.16"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "iconv-lite": "^0.7.3",
    "javascript-obfuscator": "^4.1.1",
    "rollup-obfuscator": "^4.1.1",
    "terser": "^5.46.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.novaspark.app",
    "productName": "NovaSpark",
    "asar": true,
    "compression": "normal",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/mac/**",
      "!dist/mac-arm64/**",
      "!dist/win-unpacked/**",
      "!dist/linux-unpacked/**",
      "!dist/*.dmg",
      "!dist/*.exe",
      "!dist/*.deb",
      "!dist/*.AppImage",
      "!dist/*.blockmap",
      "!dist/*.yaml",
      "!dist/.icon-icns/**",
      "src/ipc/**/*",
      "index.js",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/.cache/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,changelog.md,CHANGES,LICENCE,LICENSE}**",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples,benchmark,benchmarks}/**",
      "!**/node_modules/.bin/**",
      "!**/node_modules/*/*.d.ts",
      "!**/{.eslintrc,.babelrc,.editorconfig,.nycrc}**",
      "!**/{jest.config,jest.config.js,jest.config.ts}**",
      "!**/node_modules/*/docs/**",
      "!**/node_modules/vite/**",
      "!**/node_modules/@vitejs/**",
      "!**/node_modules/terser/**",
      "!**/node_modules/rollup/**",
      "!**/node_modules/esbuild/**",
      "!**/node_modules/@esbuild/**",
      "!**/node_modules/@rollup/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createStartMenuShortcut": true,
      "selectPerMachineByDefault": false,
      "license": "LICENSE",
      "uninstallDisplayName": "Uninstall NovaSpark",
      "installerSidebar": "public/installer-sidebar.bmp"
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "public/icon.png"
    },
    "electronLanguages": [
      "en-US",
      "de"
    ],
    "asarUnpack": [
      "src/styles/fonts/**"
    ]
  }
}
